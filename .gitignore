# ---- Nomad: Runtime 不进版本库（由 Launcher 管理与重下）----
runtime/
!runtime/.gitkeep

# ---- 上游源码：开发机阅读用，不作为 Nomad 仓库内容 ----
vendor/

# ---- 开发机打包临时区（下载的压缩包 / npm cache / 一次性脚本）----
# 只存在于开发机，绝不随 U 盘发布；见 docs/PORTABILITY.md
.cache-dev/


# ---- Nomad: 用户数据永不进版本库 ----
# data/     = 会话 / 事件 / 记忆 / 日志 / 备份 / 运行态（含带 token 的 state 文件）
# workspace/= Agent 工作区与沙箱
# skills/ profiles/ mcp/ = 用户的技能 / 档案 / MCP 配置（盘上长期存在，但不入库）
data/
workspace/
skills/
profiles/
mcp/
logs/
*.log

# ---- Secret：任何形式的明文密钥都禁止入库 ----
secrets.json
api_key.txt
provider_key*.yaml
.env
.env.*
config/*.local.yaml

# ---- Node / 构建产物 ----
node_modules/
dist/
build/
out/
.next/
.pnpm-store/
*.tsbuildinfo

# ---- AI 工作记忆 / 个人编辑器配置：开发内情，永不入库 ----
# .workbuddy/ = AI 助手的工作记忆（逐日开发日志 + 项目长期记忆），属个人开发内情
# .cursor/    = 个人编辑器规则（等价于 .vscode/，不随项目分发）
.workbuddy/
.cursor/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
